{
  "name": "jcloisterzone-engine",
  "version": "7.0.0-alpha.7",
  "description": "TypeScript port of the JCloisterZone (Carcassonne) game engine",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "sideEffects": false,
  "main": "./dist/com/jcloisterzone/index.js",
  "module": "./dist/com/jcloisterzone/index.js",
  "types": "./dist/com/jcloisterzone/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/com/jcloisterzone/index.d.ts",
      "import": "./dist/com/jcloisterzone/index.js"
    },
    "./vavr": {
      "types": "./dist/io/vavr/index.d.ts",
      "import": "./dist/io/vavr/index.js"
    }
  },
  "bin": {
    "jcz-engine": "dist/cli/jcz-engine.js"
  },
  "files": [
    "dist",
    "src/main/ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bundle": "node scripts/gen-version.mjs && npm run build && esbuild dist/cli/jcz-engine.js --bundle --platform=node --target=node16 --format=cjs --outfile=bundle/jcz-engine.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "engine": "node dist/cli/jcz-engine.js",
    "capture-golden": "node scripts/capture-golden.mjs",
    "capture-golden:ts": "node scripts/capture-golden-ts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "port:manifest": "node scripts/port-manifest.mjs"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.13"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.8.13",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0",
    "vitest": "^0.34.6"
  }
}
