  <modifier selector="road[wells]" type="+" enabled-by="well">
    <scoring>
      const { wells, inn } = this
      if (wells) {
        return [{
          count: wells,
          name: 'wells',
          points: inn ? 2 * wells : wells
        }]
      }
    </scoring>
  </modifier>

